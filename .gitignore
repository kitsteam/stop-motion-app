# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

# OS / editor cruft
*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# Logs
*.log
log.txt
npm-debug.log*
pnpm-debug.log*

# Build / dependency dirs
/.idea
/coverage
/dist
dist-ssr
/node_modules
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json

# pnpm local content-addressable store (used when pnpm can't write to the
# global store path).
.pnpm-store/

.devcontainer
