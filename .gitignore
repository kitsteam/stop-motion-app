# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt
npm-debug.log*

/.idea
/coverage
/dist
/node_modules

# pnpm local content-addressable store (created when pnpm can't write to the
# global store path — see `react-app/` for the React migration toolchain).
.pnpm-store/

.devcontainer
.nx/*

# Ignore everything in .yarn except the essential subfolders for Zero-Installs
.yarn/*
!.yarn/cache/
!.yarn/patches/
!.yarn/plugins/
!.yarn/releases/
!.yarn/sdks/
!.yarn/versions/